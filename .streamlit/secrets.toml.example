# Copy to .streamlit/secrets.toml (local, git-ignored) OR paste into the
# Streamlit Community Cloud app "Secrets" box. NEVER commit the real file.
#
# Password hashes: run  python scripts/gen_password_hash.py <your-password>
# and paste the bcrypt hash below.

# --- top-level: injected into os.environ by web/app.py, used by agent/* ---
PG_CONN_STR = "postgresql://USER:PASSWORD@HOST/DB?sslmode=require"   # Neon connection string
DEEPSEEK_API_KEY = "sk-xxxxxxxx"
ANTHROPIC_API_KEY = "sk-ant-xxxxxxxx"   # optional (only if Claude tier used)

# --- login cookie ---
cookie_key = "change-me-to-a-long-random-string"

# --- accounts & roles ---
# role ∈ {admin, viewer}.  admin: sees SQL + full data.  viewer: chart + narrative,
# SQL hidden, data truncated.
[auth.credentials.usernames.admin]
name = "管理员"
email = "admin@example.com"
password = "$2b$12$REPLACE_WITH_BCRYPT_HASH"
role = "admin"

[auth.credentials.usernames.viewer]
name = "访客"
email = "viewer@example.com"
password = "$2b$12$REPLACE_WITH_BCRYPT_HASH"
role = "viewer"
